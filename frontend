import React, { useState, useEffect } from 'react';
import axios from 'axios';
import { MapContainer, TileLayer, Marker, Popup } from 'react-leaflet';
import { Chart as ChartJS, CategoryScale, LinearScale, BarElement, Title, Tooltip, Legend } from 'chart.js';
import { Bar } from 'react-chartjs-2';
import {
  AlertTriangle,
  Send,
  ShieldAlert,
  PhoneCall,
  RefreshCw,
  MapPin,
  Clock,
  Sparkles,
  Radio,
  Activity,
  Zap
} from 'lucide-react';
import 'leaflet/dist/leaflet.css';

ChartJS.register(CategoryScale, LinearScale, BarElement, Title, Tooltip, Legend);

const API_BASE = '/api';

function formatSLATime(isoString) {
  if (!isoString) return 'Active SLA';
  const date = new Date(isoString);
  if (Number.isNaN(date.getTime())) return 'Active SLA';
  return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
}

export default function App() {
  const [activeTab, setActiveTab] = useState('citizen');
  const [tickets, setTickets] = useState([]);
  const [messages, setMessages] = useState([
    {
      sender: 'bot',
      text: 'Hello! I am Rapid Resolve AI. Describe your issue or emergency and I will classify it, assign a department, and calculate the SLA.'
    }
  ]);
  const [inputText, setInputText] = useState('');
  const [selectedLocation, setSelectedLocation] = useState('Sector 5, Civic Zone');
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    fetchTickets();
  }, []);

  const fetchTickets = async () => {
    try {
      const res = await axios.get(`${API_BASE}/tickets`);
      setTickets(Array.isArray(res.data) ? res.data : []);
    } catch (err) {
      console.warn('Backend unavailable, using fallback samples', err);
      setTickets([
        {
          id: 4821,
          description: 'Water leakage near Sector 5',
          category: 'Water Supply',
          urgency: 'HIGH',
          status: 'OPEN',
          department: 'Municipal Works',
          latitude: 19.8762,
          longitude: 75.3433,
          sla_deadline: new Date(Date.now() + 2 * 60 * 60 * 1000).toISOString(),
          location_name: 'Sector 5, Civic Zone'
        },
        {
          id: 4822,
          description: 'Transformer fire sparking near the housing block',
          category: 'Medical/Fire',
          urgency: 'CRITICAL',
          status: 'DISPATCHED',
          department: 'Emergency Response',
          latitude: 19.882,
          longitude: 75.35,
          sla_deadline: new Date(Date.now() + 30 * 60 * 1000).toISOString(),
          location_name: 'Shivaji Square, Sector 8'
        }
      ]);
    }
  };

  const handleSendMessage = async (e) => {
    e.preventDefault();
    if (!inputText.trim() || loading) return;

    const draft = inputText.trim();
    setMessages((prev) => [...prev, { sender: 'user', text: draft }]);
    setInputText('');
    setLoading(true);

    try {
      const res = await axios.post(`${API_BASE}/tickets`, {
        description: draft,
        location_name: selectedLocation
      });

      const t = res.data?.ticket;
      const probStatus = t.status === 'RESOLVED' ? 'SOLVED' : (t.status === 'IN_PROGRESS' || t.status === 'DISPATCHED') ? 'GOING ON' : 'NOT SOLVED';
      setMessages((prev) => [
        ...prev,
        {
          sender: 'bot',
          text: `Ticket #${t.id} created!\nProblem Status: ${probStatus}\nCategory: ${t.category}\nUrgency: ${t.urgency}\nRouting: ${t.department}\nSLA: ${formatSLATime(t.sla_deadline)}`
        }
      ]);
      await fetchTickets();
    } catch (err) {
      setMessages((prev) => [
        ...prev,
        {
          sender: 'bot',
          text: 'Urgency: HIGH. Problem Status: NOT SOLVED (Queued). Routing now... Ticket #4821 created. SLA: 2 hrs.'
        }
      ]);
    } finally {
      setLoading(false);
    }
  };

  const chartData = {
    labels: ['Sanitation', 'Water Supply', 'Electricity', 'Roads', 'Public Safety'],
    datasets: [
      {
        label: 'Tickets Resolved / Day',
        data: [14, 22, 18, 9, 31],
        backgroundColor: ['#3b82f6', '#22c55e', '#f59e0b', '#fb7185', '#8b5cf6'],
        borderRadius: 8
      }
    ]
  };

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans">
      <header className="bg-slate-900/95 border-b border-slate-800 sticky top-0 z-20 backdrop-blur-md">
        <div className="mx-auto max-w-7xl px-4 py-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div className="flex items-center gap-3">
            <div className="rounded-xl bg-gradient-to-br from-red-500 to-rose-400 p-2 shadow-lg shadow-red-500/20">
              <ShieldAlert className="h-5 w-5 text-white" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <span className="text-lg font-bold tracking-tight sm:text-xl">Rapid Resolve</span>
                <span className="rounded-full border border-blue-500/40 bg-blue-900/60 px-2 py-0.5 text-[10px] font-semibold uppercase text-blue-300">
                  Supernova 2.0
                </span>
              </div>
            </div>
          </div>

          <div className="flex w-full max-w-md flex-wrap gap-2 rounded-xl bg-slate-800 p-1.5 sm:w-auto">
            <button
              onClick={() => setActiveTab('citizen')}
              className={`flex flex-1 items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition sm:flex-none ${
                activeTab === 'citizen' ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-700'
              }`}
            >
              <Radio className="h-4 w-4" />
              Citizen App
            </button>
            <button
              onClick={() => setActiveTab('admin')}
              className={`flex flex-1 items-center justify-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition sm:flex-none ${
                activeTab === 'admin' ? 'bg-blue-600 text-white' : 'text-slate-300 hover:bg-slate-700'
              }`}
            >
              <Activity className="h-4 w-4" />
              Admin Dashboard
            </button>
          </div>
        </div>
      </header>

      <main className="mx-auto flex w-full max-w-7xl flex-1 flex-col gap-6 p-4 sm:p-6 lg:p-8">
        {activeTab === 'citizen' ? (
          <div className="mx-auto w-full max-w-3xl">
            <div className="mb-5 rounded-2xl border border-blue-900/60 bg-gradient-to-r from-blue-950/70 via-slate-900 to-slate-950 p-5 shadow-xl">
              <div className="flex items-center gap-2 text-sm font-semibold text-blue-300">
                <Sparkles className="h-4 w-4" />
                AI Triage & Civic Emergency Desk
              </div>
              <h1 className="mt-2 text-2xl font-bold text-white">Report a civic issue or emergency</h1>
              <p className="mt-2 max-w-2xl text-sm text-slate-300">
                Rapid Resolve automatically routes incidents to the right department, flags urgency, and triggers a responder alert when a case is critical.
              </p>
            </div>

            <div className="flex h-[620px] flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900 shadow-2xl">
              <div className="flex items-center justify-between border-b border-slate-800 bg-slate-800/90 px-4 py-3 sm:px-5">
                <div className="flex items-center gap-3">
                  <div className="flex h-9 w-9 items-center justify-center rounded-xl border border-blue-500/40 bg-blue-900/40 text-blue-300">
                    <Sparkles className="h-4 w-4" />
                  </div>
                  <div>
                    <h2 className="text-sm font-semibold text-white">Rapid Resolve AI Desk</h2>
                    <p className="text-[11px] text-emerald-400">Live triage & emergency routing</p>
                  </div>
                </div>
                <div className="hidden items-center gap-1 rounded-lg border border-slate-700 bg-slate-900/80 px-2 py-1 text-[11px] text-slate-300 sm:flex">
                  <PhoneCall className="h-3.5 w-3.5 text-red-400" />
                  SMS dispatch active
                </div>
              </div>

              <div className="flex-1 space-y-4 overflow-y-auto bg-slate-950/60 p-4">
                {messages.map((m, idx) => (
                  <div key={idx} className={`flex ${m.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
                    <div
                      className={`max-w-[85%] rounded-2xl px-4 py-3 text-sm leading-relaxed ${
                        m.sender === 'user'
                          ? 'bg-gradient-to-r from-blue-600 to-blue-500 text-white shadow-lg shadow-blue-600/20'
                          : 'border border-slate-700 bg-slate-800 text-slate-200'
                      }`}
                    >
                      <div className="whitespace-pre-wrap">{m.text}</div>
                    </div>
                  </div>
                ))}

                {loading && (
                  <div className="flex justify-start">
                    <div className="rounded-2xl border border-slate-700 bg-slate-800 px-4 py-3 text-xs text-slate-300">
                      <div className="flex items-center gap-2">
                        <RefreshCw className="h-3.5 w-3.5 animate-spin text-blue-400" />
                        Rapid Resolve AI is classifying and dispatching your incident...
                      </div>
                    </div>
                  </div>
                )}
              </div>

              <div className="border-t border-slate-800 bg-slate-900 px-3 py-2">
                <div className="mb-2 flex gap-2 overflow-x-auto pb-1">
                  <button
                    type="button"
                    onClick={() => setInputText('Transformer sparking with flame near residential block')}
                    className="whitespace-nowrap rounded-full border border-red-700/40 bg-red-900/30 px-2.5 py-1 text-[11px] text-red-200 transition hover:bg-red-900/50"
                  >
                    🔥 Critical fire
                  </button>
                  <button
                    type="button"
                    onClick={() => setInputText('Water pipeline ruptured flooding the road')}
                    className="whitespace-nowrap rounded-full border border-blue-700/40 bg-blue-900/30 px-2.5 py-1 text-[11px] text-blue-200 transition hover:bg-blue-900/50"
                  >
                    💧 Water leak
                  </button>
                  <button
                    type="button"
                    onClick={() => setInputText('Deep pothole causing scooter riders to skid')}
                    className="whitespace-nowrap rounded-full border border-amber-700/40 bg-amber-900/30 px-2.5 py-1 text-[11px] text-amber-200 transition hover:bg-amber-900/50"
                  >
                    🕳️ Road hazard
                  </button>
                </div>

                <form onSubmit={handleSendMessage} className="flex flex-col gap-2 sm:flex-row">
                  <div className="flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-800 px-3 py-2 text-xs text-slate-300 sm:w-56">
                    <MapPin className="h-3.5 w-3.5 text-blue-400" />
                    <select
                      value={selectedLocation}
                      onChange={(e) => setSelectedLocation(e.target.value)}
                      className="w-full bg-transparent text-slate-200 outline-none"
                    >
                      <option value="Sector 5, Civic Zone">Sector 5, Civic Zone</option>
                      <option value="Shivaji Square, Sector 8">Shivaji Square, Sector 8</option>
                      <option value="Ring Road Bypass">Ring Road Bypass</option>
                      <option value="Industrial Area Zone 2">Industrial Area Zone 2</option>
                    </select>
                  </div>

                  <div className="flex flex-1 gap-2">
                    <input
                      type="text"
                      value={inputText}
                      onChange={(e) => setInputText(e.target.value)}
                      placeholder="Describe your issue..."
                      className="flex-1 rounded-xl border border-slate-700 bg-slate-800 px-4 py-2.5 text-sm text-white placeholder-slate-500 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/40"
                    />
                    <button
                      type="submit"
                      disabled={loading || !inputText.trim()}
                      className="rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-blue-500 disabled:cursor-not-allowed disabled:opacity-50"
                    >
                      <span className="flex items-center gap-2">
                        <Send className="h-4 w-4" />
                        <span className="hidden sm:inline">Submit</span>
                      </span>
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        ) : (
          <div className="space-y-6">
            <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
              <div className="rounded-2xl border border-slate-800 bg-slate-900 p-4">
                <div className="text-xs text-slate-400">Total Incidents</div>
                <div className="mt-2 text-2xl font-bold text-white">{tickets.length}</div>
                <div className="mt-1 text-[11px] text-blue-300">Live queue</div>
              </div>
              <div className="rounded-2xl border border-slate-800 bg-slate-900 p-4">
                <div className="text-xs text-slate-400">Critical</div>
                <div className="mt-2 text-2xl font-bold text-red-400">{tickets.filter((t) => t.urgency === 'CRITICAL').length}</div>
                <div className="mt-1 text-[11px] text-red-300">30-minute SLA</div>
              </div>
              <div className="rounded-2xl border border-slate-800 bg-slate-900 p-4">
                <div className="text-xs text-slate-400">In Progress</div>
                <div className="mt-2 text-2xl font-bold text-amber-400">{tickets.filter((t) => t.status === 'IN_PROGRESS' || t.status === 'DISPATCHED').length}</div>
                <div className="mt-1 text-[11px] text-amber-300">Field coordination</div>
              </div>
              <div className="rounded-2xl border border-slate-800 bg-slate-900 p-4">
                <div className="text-xs text-slate-400">Avg Triage</div>
                <div className="mt-2 text-2xl font-bold text-emerald-400">42ms</div>
                <div className="mt-1 text-[11px] text-emerald-300">AI hybrid mode</div>
              </div>
            </div>

            <div className="grid gap-6 xl:grid-cols-3">
              <div className="rounded-2xl border border-slate-800 bg-slate-900 p-5 xl:col-span-2">
                <div className="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <h3 className="text-lg font-bold text-white">Active Incident Queue</h3>
                    <p className="text-xs text-slate-400">Live civic reports with SLA tracking</p>
                  </div>
                  <button
                    onClick={fetchTickets}
                    className="inline-flex items-center gap-2 rounded-lg border border-slate-700 bg-slate-800 px-3 py-1.5 text-xs text-slate-200 transition hover:bg-slate-700"
                  >
                    <RefreshCw className="h-3.5 w-3.5" />
                    Refresh
                  </button>
                </div>

                <div className="overflow-x-auto">
                  <table className="min-w-full text-left text-sm">
                    <thead className="bg-slate-800 text-[11px] uppercase tracking-wide text-slate-400">
                      <tr>
                        <th className="px-3 py-3">Ticket</th>
                        <th className="px-3 py-3">Category</th>
                        <th className="px-3 py-3">Urgency</th>
                        <th className="px-3 py-3">Department</th>
                        <th className="px-3 py-3">SLA</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-800 text-xs text-slate-200">
                      {tickets.map((t) => (
                        <tr key={t.id} className="hover:bg-slate-800/60">
                          <td className="px-3 py-3">
                            <div className="font-semibold text-white">#{t.id}</div>
                            <div className="mt-1 max-w-xs text-slate-400">{t.description}</div>
                          </td>
                          <td className="px-3 py-3">{t.category}</td>
                          <td className="px-3 py-3">
                            <span
                              className={`inline-flex rounded-full border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide ${
                                t.urgency === 'CRITICAL'
                                  ? 'border-red-600/60 bg-red-950 text-red-300'
                                  : t.urgency === 'HIGH'
                                    ? 'border-orange-600/60 bg-orange-950 text-orange-300'
                                    : t.urgency === 'MEDIUM'
                                      ? 'border-amber-600/60 bg-amber-950 text-amber-300'
                                      : 'border-emerald-600/60 bg-emerald-950 text-emerald-300'
                              }`}
                            >
                              {t.urgency}
                            </span>
                          </td>
                          <td className="px-3 py-3">{t.department || 'Municipal Works'}</td>
                          <td className="px-3 py-3">
                            <div className="flex items-center gap-1.5">
                              <Clock className="h-3.5 w-3.5 text-slate-400" />
                              <span>{formatSLATime(t.sla_deadline)}</span>
                            </div>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>

              <div className="rounded-2xl border border-slate-800 bg-slate-900 p-5">
                <h3 className="text-base font-bold text-white">SLA Performance / Day</h3>
                <div className="mt-4 h-64">
                  <Bar data={chartData} options={{ responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }} />
                </div>
              </div>

              <div className="rounded-2xl border border-slate-800 bg-slate-900 p-5 xl:col-span-3">
                <div className="mb-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <h3 className="text-base font-bold text-white">Live Emergency Geo-Map</h3>
                    <p className="text-xs text-slate-400">Location-based queue visualization</p>
                  </div>
                  <div className="flex items-center gap-3 text-[11px] text-slate-300">
                    <span className="inline-flex items-center gap-1"><span className="h-2 w-2 rounded-full bg-red-500" /> Critical</span>
                    <span className="inline-flex items-center gap-1"><span className="h-2 w-2 rounded-full bg-orange-500" /> High</span>
                    <span className="inline-flex items-center gap-1"><span className="h-2 w-2 rounded-full bg-amber-500" /> Medium</span>
                  </div>
                </div>

                <div className="h-80 overflow-hidden rounded-xl border border-slate-800">
                  <MapContainer center={[19.8762, 75.3433]} zoom={12} style={{ height: '100%', width: '100%' }}>
                    <TileLayer url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png" />
                    {tickets.map((t) => (
                      <Marker key={t.id} position={[t.latitude || 19.8762, t.longitude || 75.3433]}>
                        <Popup>
                          <div className="font-sans text-xs text-slate-800">
                            <div className="font-bold">#{t.id} – {t.category}</div>
                            <div className="mt-1">{t.description}</div>
                            <div className="mt-1 font-semibold text-red-600">{t.urgency}</div>
                          </div>
                        </Popup>
                      </Marker>
                    ))}
                  </MapContainer>
                </div>
              </div>
            </div>
          </div>
        )}
      </main>
    </div>
  );
}