# Server Configuration
PORT=5000

# Database Configuration (PostgreSQL)
# If left empty or unreachable, RapidResolve seamlessly activates in-memory storage mode
DATABASE_URL=postgresql://postgres:password@localhost:5432/rapidresolve

# Google Gemini AI API Configuration
GEMINI_API_KEY=

# Anthropic Claude API Configuration (Optional)
# If neither Gemini nor Claude are provided, RapidResolve uses intelligent local heuristic triage
ANTHROPIC_API_KEY=

# Twilio SMS Alert Configuration
# If not provided, emergency dispatches are logged to the console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESPONDER_PHONE_NUMBER=
